# AI 영작 훈련용 API 키
GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=... (선택 사항, Groq 실패 시 보조)
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=sk-... (선택 사항)
# NVIDIA_NIM_API_KEY=nvapi-... (선택 사항, Groq 한도 초과 시 보조)
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-8b-instruct

# Copy to .env and fill in values from the Supabase project settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
